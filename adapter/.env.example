ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8765
DB_PATH=./trade_ledger.db
REPLAY_DIR=./replay_tapes
DECIDER=dummy_trend_breakout
ADAPTER_DEFAULT_MAX_DEVIATION_POINTS=20

# --- Security -----------------------------------------------------------
# The adapter refuses to start if ADAPTER_HOST is not loopback while
# HMAC_REQUIRED is false, because that would expose unauthenticated trading
# endpoints on the network. Binding beyond 127.0.0.1 therefore requires BOTH
# HMAC_REQUIRED=true and a real INTERNAL_HMAC_KEY (the placeholder below is
# rejected at startup).
HMAC_REQUIRED=false
INTERNAL_HMAC_KEY=change-me-dev-only

# Largest accepted request body (bytes). Real payloads are ~2-4 KB.
MAX_REQUEST_BYTES=262144

# FastAPI's /docs maps every trading endpoint; keep it off outside development.
ENABLE_DOCS=false

# --- Claude (Phase 2, unused today) -------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_TIMEOUT_SECONDS=1.6
