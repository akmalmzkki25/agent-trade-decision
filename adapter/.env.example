ADAPTER_HOST=127.0.0.1
ADAPTER_PORT=8765
DB_PATH=./trade_ledger.db
REPLAY_DIR=./replay_tapes
DECIDER=dummy_trend_breakout
ADAPTER_DEFAULT_MAX_DEVIATION_POINTS=20

# --- Security -----------------------------------------------------------
# The adapter refuses to start if ADAPTER_HOST is not loopback while
# HMAC_REQUIRED is false, because that would expose unauthenticated trading
# endpoints on the network. Binding beyond 127.0.0.1 therefore requires BOTH
# HMAC_REQUIRED=true and a real INTERNAL_HMAC_KEY (the placeholder below is
# rejected at startup).
HMAC_REQUIRED=false
INTERNAL_HMAC_KEY=change-me-dev-only

# Host headers the adapter answers besides 127.0.0.1, localhost and [::1]
# (DNS-rebinding defence). Comma-separated names or addresses, no wildcards.
# Required when ADAPTER_HOST=0.0.0.0, e.g. ALLOWED_HOSTS=192.168.1.10
ALLOWED_HOSTS=

# Largest accepted request body (bytes). Real payloads are ~2-4 KB.
MAX_REQUEST_BYTES=262144

# FastAPI's /docs maps every trading endpoint; keep it off outside development.
ENABLE_DOCS=false

# --- Claude (Phase 2, unused today) -------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-7
ANTHROPIC_TIMEOUT_SECONDS=1.6

# --- V6 (multi-agent XAUUSD desk) ----------------------------------------
# Run the adapter with ONE worker and no reload while V6 is enabled:
#   uvicorn app.main:app --host 127.0.0.1 --port 8765 --workers 1
# The runtime (deliberation worker + watchdog) is an in-process task guarded by a
# database lock; a second process on the same database stays disabled.
#
# Every closed M15 bar is analysed and recorded. Decisions come from a backend:
#   rules     the deterministic desks (shadow only)
#   operator  an operator agent in a chat session (Claude Code, Codex or
#             Antigravity) submits the decision; DEMO accounts only, for every
#             agent, whatever else is configured (AGENTS.md, docs/v6-operator.md)
# Wire contract (EA <-> adapter, signatures, EA rules): docs/v6-wire-contract.md
V6_ENABLED=false
# off | shadow | execute
#   shadow   decisions are recorded, the EA poll never receives an intent
#   execute  DEMO only; needs V6_BACKEND=operator, V6_EA_HMAC_KEY and V6_MAX_LOTS<=0.01,
#            and publishes intents only while a daily session is active and armed
V6_MODE=shadow
# rules | operator
V6_BACKEND=rules
# Agents allowed to submit operator decisions (comma-separated, distinct):
#   claude_code (Claude Code), codex (Codex), antigravity (Antigravity)
V6_OPERATOR_AGENTS=claude_code,codex,antigravity
# Bearer token for /v6/control/*, the operator API and scripts/v6_operator.py: at
# least 32 random characters you generate yourself, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# Never commit the real value. Required for V6_BACKEND=operator. Empty = control
# routes answer 503 (dashboard HALT still works).
V6_OPERATOR_TOKEN=
# HMAC key shared with the V6 EA (32-256 printable ASCII characters, no spaces);
# required for V6_MODE=execute, independent of INTERNAL_HMAC_KEY. Generate it like
# the token above, then copy it to the terminal with
#   python adapter/scripts/v6_sync_ea_key.py --data-folder "<MT5 data folder>"
# Never commit the real value.
V6_EA_HMAC_KEY=
# Kill switch: creating this file (relative to adapter/) halts V6.
V6_HALT_FILE=V6_HALT

# Timing
# bar close + this = LATE
V6_DECISION_DEADLINE_S=120
# bar close + this = the operator decision is too late (APP-V6-OPERATOR-TIMEOUT)
V6_OPERATOR_DEADLINE_S=300
# how long a published intent may be picked up by the EA (30-300 s);
# V6_OPERATOR_DEADLINE_S + V6_INTENT_TTL_S + 60 must fit in the pending expiry
V6_INTENT_TTL_S=120
V6_SNAPSHOT_STALE_S=20
V6_EA_STALE_S=30
V6_MAX_CLOCK_SKEW_S=5
# The broker's daily no-quote window, HH:MM-HH:MM UTC ("" for none). No bar forms
# there, so the watchdog does not call it STALE and the labeler does not call it a
# data gap. Probe 2026-09-16 (MetaQuotes-Demo): 20:00-22:00.
V6_BROKER_QUOTE_GAP_UTC=20:00-22:00

# Account policy (V6.0 trades DEMO accounts only; true is refused at startup)
V6_ALLOW_REAL_ACCOUNT=false
V6_DEMO_SERVER_PATTERN=(?i)(trial|demo)
# comma-separated; empty = any DEMO login
V6_ALLOWED_LOGINS=

# Sizing and limits (values may only tighten the built-in ceilings)
# standard ($0.40/oz friction, 35 pt spread) | raw
V6_ACCOUNT_TYPE=standard
V6_RISK_PCT=0.5
V6_SIZING_EQUITY_BASIS_USD=2000
# execute mode refuses anything above 0.01
V6_MAX_LOTS=0.01
V6_MAX_TRADES_PER_DAY=4
# optional; defaults to the account-type ceiling
# V6_MAX_SPREAD_POINTS=35
V6_STOP_FLOOR_POINTS=600
V6_MIN_ATR_M5_POINTS=250
V6_FRICTION_ATR_MAX=0.08
V6_NOTIONAL_RATIO_MAX=10
V6_DAILY_LOSS_PCT=3
V6_WEEKLY_LOSS_PCT=6
V6_MONTHLY_LOSS_PCT=10

# Exits
V6_TIME_BARRIER_BARS=8
V6_PENDING_EXPIRY_BARS=2
V6_TP_R_MULTIPLE=2.0

# Execution (EA contract)
# must equal the EA input InpMagic (250570-250579)
V6_MAGIC=250570
# cap (10-1000) of an intent's max_drift_points: 20% of its stop distance, at most
# this; the EA refuses the intent once the price moved further from the decision
V6_MAX_DRIFT_POINTS=200

# Deliberation
V6_PA_MIN_CONVICTION=0.6
V6_DEBATE_ROUNDS=1
# log (shadow) | enforce
V6_STRUCTURE_VETO=log

# News: comma-separated allowlisted RSS URLs
V6_NEWS_RSS_URLS=
